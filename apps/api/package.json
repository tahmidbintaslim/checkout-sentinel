{
  "name": "@checkout-sentinel/api",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS API for monitors, run history and status, with OpenAPI docs and Prometheus metrics.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "@checkout-sentinel/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@checkout-sentinel/core": "workspace:*",
    "@checkout-sentinel/db": "workspace:*",
    "@checkout-sentinel/jobs": "workspace:*",
    "@nestjs/common": "^12.2.0",
    "@nestjs/core": "^12.2.0",
    "@nestjs/platform-express": "^12.2.0",
    "@nestjs/swagger": "^12.0.3",
    "express": "^5.3.0",
    "ioredis": "6.0.0",
    "nestjs-pino": "^5.3.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@checkout-sentinel/fixtures": "workspace:*",
    "@types/express": "^5.0.6"
  },
  "files": [
    "dist"
  ]
}
