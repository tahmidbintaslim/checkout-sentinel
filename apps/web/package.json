{
  "name": "@checkout-sentinel/web",
  "version": "0.2.0",
  "private": true,
  "description": "Dashboard for checkout-sentinel: monitors, run history, step timelines, screenshots and the alert log.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "screenshots": "node --experimental-strip-types scripts/screenshots.ts"
  },
  "dependencies": {
    "@checkout-sentinel/core": "workspace:*",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@checkout-sentinel/api": "workspace:*",
    "@checkout-sentinel/db": "workspace:*",
    "@checkout-sentinel/fixtures": "workspace:*",
    "@checkout-sentinel/jobs": "workspace:*",
    "@checkout-sentinel/worker": "workspace:*",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^30.1.3",
    "pino": "^10.4.0",
    "playwright": "1.64.1",
    "vite": "8.3.5",
    "vue-tsc": "^3.3.13"
  }
}
