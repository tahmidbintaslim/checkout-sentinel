{
  "name": "checkout-sentinel-monorepo",
  "private": true,
  "description": "Synthetic add-to-cart and checkout monitoring for Shopify and WooCommerce stores.",
  "license": "MIT",
  "author": "Tahmid Bin Taslim Rafi",
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "pnpm -r --filter=./packages/** --filter=./apps/** --filter=./test/** run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit --project web",
    "test:integration": "vitest run --project integration",
    "test:e2e": "vitest run --project e2e",
    "fixtures": "pnpm --filter @checkout-sentinel/fixtures run start"
  },
  "devDependencies": {
    "@checkout-sentinel/core": "workspace:*",
    "@checkout-sentinel/fixtures": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "eslint-plugin-vuejs-accessibility": "^2.6.3",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5",
    "vue-eslint-parser": "^10.4.1"
  }
}
