# Copy to .env for docker compose, or export for local development.

# --- Postgres (docker-compose builds DATABASE_URL from these) ---
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=change-me
POSTGRES_DB=checkout_sentinel

# For running the API or worker outside docker:
# DATABASE_URL=postgres://sentinel:change-me@localhost:5432/checkout_sentinel
# REDIS_URL=redis://localhost:6379

# --- API ---
API_PORT=3000
# Bearer token for every route except /health, /metrics and /docs. At least 16 characters.
# Leave empty only on a private network.
API_TOKEN=
# Apply database migrations when the API starts (the worker never migrates).
# MIGRATE_ON_BOOT=true

# --- Outbound URL checks (API and worker; set both the same) ---
# Monitor, webhook and Slack URLs that point at private, loopback, link-local (cloud metadata)
# or other internal addresses are refused. true turns these checks off: local development
# against a store on your own machine only, never where other people can create monitors.
ALLOW_PRIVATE_TARGETS=false
# Comma-separated host names or IPs, matched exactly, that may resolve to private addresses,
# for example an internal alert relay.
ALLOWED_TARGET_HOSTS=
# Comma-separated ports allowed besides 80 and 443.
ALLOWED_TARGET_PORTS=

# --- Worker ---
# Journeys run in parallel per worker process (one shared Chromium, one context per journey).
WORKER_CONCURRENCY=2
# Journeys allowed at the same time against one store host, across all workers.
PER_STORE_CONCURRENCY=1
# Optional: link to the API in alert messages, for example https://sentinel.example.com
PUBLIC_BASE_URL=
# Optional: URL in the user agent so merchants can find out who is running checks.
# Defaults to the project's GitHub URL.
USER_AGENT_CONTACT_URL=
# Timeouts in milliseconds.
# NAVIGATION_TIMEOUT_MS=30000
# STEP_TIMEOUT_MS=15000
# ALERT_TIMEOUT_MS=10000
# Housekeeping: each worker tries a pass on start and on this interval; a Redis lock lets one
# pass run at a time. 0 turns it off on that worker.
# HOUSEKEEPING_INTERVAL_MS=300000
# A run still "running" this long after it started is marked error ("Worker lost"). Default:
# 15 minutes, or longer when the timeouts above allow longer runs.
# RUN_STALE_AFTER_MS=900000
# Days of run history to keep (runs, their alert log rows and artifacts). 0 keeps everything.
# RUN_RETENTION_DAYS=30

# --- Local development only ---
# Use a preinstalled Chromium instead of Playwright's download (e.g. in a sandbox).
# CHECKOUT_SENTINEL_CHROMIUM_PATH=/opt/pw-browsers/chromium

LOG_LEVEL=info
